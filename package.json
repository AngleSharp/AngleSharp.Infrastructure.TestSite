{
  "name": "anglesharp-testsite",
  "version": "1.0.0",
  "description": "The webpage to run reliable online integration tests against (Node.js/Fastify port).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "busboy": "^1.6.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
